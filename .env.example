# Токен, выданный @BotFather
BOT_TOKEN=123456789:AAExampleTelegramBotTokenReplaceMe

# Telegram user id владельца — единственный, кому бот отвечает и шлёт уведомления.
# Узнать свой id можно, например, у @userinfobot
OWNER_CHAT_ID=123456789

# Часовой пояс владельца — используется для «тихих часов» и часового
# пояса браузера (имя из базы IANA, например Europe/Moscow, Asia/Yekaterinburg)
TIMEZONE=Europe/Moscow

# Пути (опционально, по умолчанию — data/ и logs/ внутри проекта)
DB_PATH=data/avito_watcher.db
LOG_DIR=logs
BROWSER_PROFILE_DIR=data/browser_profile
