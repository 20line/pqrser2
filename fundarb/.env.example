# Trading-only keys. NEVER grant withdrawal permission. Bind each key to the
# server's IP address on the exchange side. Use separate keys for testnet
# and mainnet, never mix them.

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# Optional: Telegram alerts (monitor module). Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

FUNDARB_CONFIG=config/config.yaml
FUNDARB_DATA_DIR=data
